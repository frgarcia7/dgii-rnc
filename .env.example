# Credenciales y conexión a PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_BIND_HOST=127.0.0.1
DB_EXTERNAL_PORT=5432
DB_USER=dgii_user
DB_PASSWORD=dgii_password
DB_NAME=dgii_rnc
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# Puerto HTTP expuesto por la API
API_PORT=8000
LOG_LEVEL=INFO

# Horario diario de sincronización automática (hora local según TZ)
SYNC_HOUR=3
SYNC_MINUTE=0
ENABLE_SCHEDULER=true
SYNC_BATCH_SIZE=10000

# Fuente oficial DGII (opcional: DGII_LOCAL_ZIP_PATH para carga offline desde archivo local)
DGII_RNC_URL=https://dgii.gov.do/app/WebApps/Consultas/RNC/RNC_CONTRIBUYENTES.zip
# DGII_LOCAL_ZIP_PATH=/data/RNC_CONTRIBUYENTES.zip
DGII_HTTP_RETRIES=3

# Seguridad, caché y límites para despliegues públicos o corporativos
CORS_ORIGINS=*
# API_KEY=cambia-esta-clave-si-deseas-proteger-consultas
# SYNC_API_KEY=cambia-esta-clave-para-proteger-post-sync
ENABLE_MANUAL_SYNC=true
ALLOW_UNAUTHENTICATED_SYNC=false
BATCH_MAX_ITEMS=200
CACHE_MAX_AGE_SECONDS=300
STATS_CACHE_TTL_SECONDS=300
LOOKUP_CACHE_SIZE=2048
LOOKUP_CACHE_TTL_SECONDS=300

# Rate limiting por IP (activar TRUST_PROXY_HEADERS=true solo detrás de Caddy/Nginx/Cloudflare)
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOOKUP_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_BATCH_PER_MINUTE=15
RATE_LIMIT_SYNC_PER_MINUTE=5
RATE_LIMIT_API_KEY_MULTIPLIER=5

# Zona horaria del contenedor API
TZ=America/Santo_Domingo
